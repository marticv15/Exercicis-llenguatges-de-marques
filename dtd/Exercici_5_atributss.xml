<!ATTLIST Adreca 
          Carrer CDATA #REQUIRED
          Ciutat CDATA #IMPLIED
          CP CDATA #REQUIRED
          >

<!ELEMENT Carrer (#PCDATA)>
<!ELEMENT Ciutat (#PCDATA)>
<!ELEMENT CP (#PCDATA)>
]>

