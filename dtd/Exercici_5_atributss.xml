<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Empresa [
<!ELEMENT Empresa (Empleat+)>
<!ELEMENT Empleat (Cognom_1,Cognom_2,Nom,(CorreuElectronic | Telefon), Adreca)>
<!ELEMENT Cognom_1 (#PCDATA)>
<!ELEMENT Cognom_2 (#PCDATA)>
<!ELEMENT Nom (#PCDATA)>
<!ATTLIST Empleat 
          NumEmpleat CDATA #REQUIRED>

<!ELEMENT CorreuElectronic (#PCDATA)>
<!ELEMENT Telefon (#PCDATA)>
