<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE persona [
  <!ELEMENT persona (nom, dona, data_naixement, ciutat)>
  <!ELEMENT nom (#PCDATA)>
  <!ELEMENT dona EMPTY>
  <!ELEMENT data_naixement EMPTY>
  <!ATTLIST data_naixement 
                dia CDATA #REQUIRED 
                mes CDATA #REQUIRED 
                any CDATA #FIXED "2000"
                >

  <!ELEMENT dia (#PCDATA)>
  <!ELEMENT mes (#PCDATA)>
  <!ELEMENT any (#PCDATA)>
  <!ELEMENT ciutat (#PCDATA)>
]>
